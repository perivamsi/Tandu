// Cloudflare Workers static-assets config, used by git-connected builds
// (`wrangler deploy`). `wrangler pages deploy` (deploy.sh) ignores this file
// because it has no `pages_build_output_dir`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tandu",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Client-side routing: unknown paths (e.g. /activity/chess) serve
    // index.html. Replaces the Pages-style `/* /index.html 200` _redirects
    // rule, which Workers rejects as an infinite loop.
    "not_found_handling": "single-page-application"
  }
}
